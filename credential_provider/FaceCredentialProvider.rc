// Stage 9 (R3 F-88, F-96): the tile image and a VERSIONINFO resource -- publisher, product and
// version for Explorer, for signing (decision 9-01) and for anyone asking "what is this DLL?".
#include <winver.h>
#include "resource.h"
#include "version.h"

IDB_TILE_IMAGE BITMAP "tile.bmp"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FU_VERSION_BIN
 PRODUCTVERSION FU_VERSION_BIN
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "xbaox"
            VALUE "FileDescription", "Windows Face Unlock credential provider"
            VALUE "FileVersion", FU_VERSION_STR
            VALUE "InternalName", "FaceCredentialProvider"
            VALUE "LegalCopyright", "MIT License. See LICENSE."
            VALUE "OriginalFilename", "FaceCredentialProvider.dll"
            VALUE "ProductName", "Windows Face Unlock"
            VALUE "ProductVersion", FU_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
